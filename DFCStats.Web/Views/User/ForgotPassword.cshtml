@model DFCStats.Web.Models.Users.ForgotPassword;

@if (TempData["Success"] != null)
{
    <div class="row mb-3">
        <div class="col-12">

            <div class="alert alert-success" role="alert">
                @TempData["Success"]
            </div>

        </div>
    </div>
}

<div class="row mb-3">
    <div class="col-12">
        <p>If you've forgot your password enter your email address below. A reset code and link will be sent to your email address which will allow you to reset your password.</p>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="row mb-3">
        <label asp-for="EmailAddress" class="col-2 col-form-label"></label>
        <div class="col-10 col-lg-4">
            <input asp-for="EmailAddress" class="form-control" />
            <span asp-validation-for="EmailAddress" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-2"></div>
        <div class="col-10">
            <button type="submit" class="btn btn-primary">Reset Password</button>
        </div>
    </div>
</form>