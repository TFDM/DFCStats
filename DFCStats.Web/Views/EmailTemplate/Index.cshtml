@model List<DFCStats.Web.Models.EmailTemplates.EmailTemplate>;

@if (TempData["Success"] != null)
{
    <div class="row mb-3">
        <div class="col-12">

            <div class="alert alert-success" role="alert">
                @TempData["Success"]
            </div>

        </div>
    </div>
}

<div class="row">
    <div class="col-12">

        <table class="table">
			<thead>
				<tr>
					<th class="table-light">Title</th>
                    <th class="table-light">Is Html</th>
                    <th class="table-light"></th>
                </tr>
			</thead>
			<tbody class="table-group-divider">

                @if (Model != null)
		        {
                    if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center table-warning text-warning-emphasis">There are no templates</td>
                        </tr>
                    } else {
                        @foreach (DFCStats.Web.Models.EmailTemplates.EmailTemplate template in Model)
                        {
                            <tr>
                                <td class="table-light">@template.Title</td>
                                <td class="table-light">
                                    @if (template.IsHtml)
                                    {
                                        <i class="fa-solid fa-check text-success"></i>
                                    } else {
                                        <i class="fa-solid fa-xmark text-danger"></i>
                                    }
                                </td>
                                <td class="align-middle table-light"><a asp-action="Edit" asp-route-id="@template.Id">Edit</a></td>
                            </tr>
                        }
                    }
                } else {
			        <tr>
				        <td colspan="3" class="text-center table-danger text-danger-emphasis">There was a problem getting the templates - please refresh the page</td>
			        </tr>
		        }
            </tbody>
        </table>

    </div>
</div>