@model DFCStats.Web.Models.Tables.NewTable

@if (TempData["Success"] != null)
{
    <div class="row mb-3">
        <div class="col-12">

            <div class="alert alert-success" role="alert">
                @TempData["Success"]
            </div>

        </div>
    </div>
}

@if (TempData["Failure"] != null)
{
    <div class="row mb-3">
        <div class="col-12">

            <div class="alert alert-danger" role="alert">
                @TempData["Failure"]
            </div>

        </div>
    </div>
}

<div id="addEditForm">
	<partial name="Partial_AddToTable" />
</div>

<div class="row">
	<div class="col-12" id="table">
		<partial name="Partial_LeagueTable" model="(List<DFCStats.Web.Models.Tables.Tables>)ViewBag.table" />
	</div>
</div>

@section Scripts
{
	<!--Loads in the required javascript to make the manage tables page work-->
	<script src="~/js/ManageTables.js" asp-append-version="true"></script>
}